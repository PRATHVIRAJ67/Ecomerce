{
  // URU customer website on Cloudflare Workers: static Vite build + /media/* (images) and /download/* (Android APK) from R2.
  "name": "uru-store",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only image and APK requests run the Worker; everything else is served straight from static assets.
    "run_worker_first": ["/download/*", "/media/*"]
  },
  "r2_buckets": [
    { "binding": "APP_FILES", "bucket_name": "uru-downloads" },
    { "binding": "MEDIA", "bucket_name": "uru-media" }
  ]
}
