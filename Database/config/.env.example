# ONE shared Supabase project for Website, Mobile, Admin and Super Admin.
# Project: https://supabase.com/dashboard/project/<project-ref>
#
# Session pooler connection string (Project → Connect → Session pooler). URL-encode special
# characters in the password (@ → %40, # → %23, / → %2F). Do not add ?sslmode — use DATABASE_SSL.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=no-verify
